{
  "env": {
    "CLAUDE_CODE_ENABLE_TODO_TOOLS": "true"
  },
  "permissions": {
    "allow": [
      "Read(~/.claude/**)"
    ],
    "defaultMode": "default"
  },
  "disableClaudeAiConnectors": true,
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/scripts/session_end_notes.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/scripts/session_end_sweep.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/scripts/session_start_notes.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/scripts/claude_account.sh check"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "slack@claude-plugins-official": false
  },
  "feedbackDrafts": "off",
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "theme": "dark-ansi",
  "verbose": true,
  "autoCompactEnabled": false,
  "agentPushNotifEnabled": true,
  "useAutoModeDuringPlan": false
}
